# =============================================================================
# ERX Autonomous SEO Daemon — Configuration (.env)
# =============================================================================

# Execution mode: 'daemon' (24/7 loop), 'once', 'keyword-only', or 'watch-only'
SEO_DAEMON_MODE=daemon

# Daily trigger time for Loop 1 (Hot Keyword Discovery & Auto-SEO) in Asia/Ho_Chi_Minh
SEO_DAILY_TIME=07:00

# Interval in seconds for Loop 2 (Platform New Content & Tag Watcher) — 900s = 15 minutes
SEO_WATCH_INTERVAL=900

# Number of top unoptimized keywords to select & execute per platform per day
KEYWORDS_PER_PLATFORM_PER_DAY=1

# Optional: Session cookie for https://erx.vn/administrator. Only used to verify edit pages are reachable; patches are staged in reports/erx_cms_auto_patch.js, not written to the CMS.
ERX_ADMIN_COOKIE=

# Optional: Automatically git commit & push updated SEO keyword manifests to sibling repos
AUTO_GIT_COMMIT=false

# Optional: Custom shell hook command executed by MUSE Agent after each daily keyword cycle
MUSE_AGENT_HOOK_CMD=python muse_repo_auto_deployer.py

# Optional: IndexNow key (Bing/Yandex etc.; Google does not use IndexNow). The key file
# must be reachable at https://<host>/<key>.txt on every submitted host.
INDEXNOW_KEY=

# Optional: set to 1 ONLY behind an intercepting egress proxy whose CA is not installed.
# Default is full TLS certificate verification.
SEO_INSECURE_SSL=
